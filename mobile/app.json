{
  "expo": {
    "name": "AttendX",
    "slug": "attendx",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "attendx",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AttendX needs location to verify you are in class."
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "android": {
      "package": "com.attendx.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1B3F"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.attendx.app"
    }
  }
}
